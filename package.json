{
  "name": "my-ide",
  "version": "0.8.1",
  "description": "私人定制轻量编辑器：PyCharm 核心体验（文件树/大纲/Git），低内存可扩展（插件渲染）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:git": "node tests/git.test.js",
    "test:dom": "node tests/dom.test.js",
    "test": "npm run check:js && npm run test:git && npm run test:dom",
    "demo": "node scripts/make-demo.js",
    "build": "electron-builder --win portable",
    "bench": "node scripts/bench.js",
    "check:js": "node scripts/syntax-check.js"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "highlight.js": "^11.10.0",
    "iconv-lite": "^0.7.3",
    "isomorphic-git": "^1.27.1",
    "marked": "^15.0.0",
    "mermaid": "^11.17.2",
    "mysql2": "^3.24.2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "local.myide.app",
    "productName": "MyIDE",
    "files": [
      "main.js",
      "preload.js",
      "git-service.js",
      "git-worker.js",
      "db-service.js",
      "ai-service.js",
      "package.json",
      "renderer/**",
      "plugins/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "MyIDE-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "author": "My IDE"
}
